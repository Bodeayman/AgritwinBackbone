{
  "info": {
    "name": "AgriTwin Full Mock Collection",
    "_postman_id": "full-mock-collection-001",
    "description": "Postman collection that includes example responses for **every** endpoint in the AgriTwin backend. Each request contains one or more example responses (success and common error cases). These examples can be edited to define custom input/output for Postman's Mock Server feature.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "{{mock_url}}", "type": "string" },
    { "key": "jwt_token", "value": "", "type": "string" },
    { "key": "api_key", "value": "REDACTED_INTERN_KEY", "type": "string" }
  ],
  "item": [
    {
      "name": "01 - Auth (Farmer)",
      "item": [
        {
          "name": "Register Farmer",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {"raw": "{{base_url}}/api/v1/auth/register", "host": ["{{base_url}}"], "path": ["api","v1","auth","register"]},
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"farmer@example.com\",\n  \"password\": \"strongpassword123\"\n}"}
          },
          "response": [
            {"name": "Success", "status": "Created", "code": 201, "header": [{"key": "Content-Type", "value": "application/json"}], "body": "{\n  \"id\": 1,\n  \"email\": \"farmer@example.com\",\n  \"role\": \"farmer\"\n}"},
            {"name": "Duplicate Email", "status": "Bad Request", "code": 400, "header": [{"key": "Content-Type", "value": "application/json"}], "body": "{\n  \"detail\": \"Email already registered\"\n}"}
          ]
        },
        {
          "name": "Login Farmer",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {"raw": "{{base_url}}/api/v1/auth/login", "host": ["{{base_url}}"], "path": ["api","v1","auth","login"]},
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"farmer@example.com\",\n  \"password\": \"strongpassword123\"\n}"}
          },
          "response": [
            {"name": "Success", "status": "OK", "code": 200, "header": [{"key": "Content-Type", "value": "application/json"}], "body": "{\n  \"access_token\": \"{{jwt_token}}\",\n  \"token_type\": \"bearer\"\n}"},
            {"name": "Bad Credentials", "status": "Unauthorized", "code": 401, "header": [{"key": "Content-Type", "value": "application/json"}], "body": "{\n  \"detail\": \"Incorrect email or password\"\n}"}
          ]
        }
      ]
    },
    {
      "name": "02 - Farm (Farmer)",
      "item": [
        {
          "name": "Create Farm",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{jwt_token}}"}
            ],
            "url": {"raw": "{{base_url}}/api/v1/farms", "host": ["{{base_url}}"], "path": ["api","v1","farms"]},
            "body": {"mode": "raw", "raw": "{\n  \"name\": \"Green Valley Farm\",\n  \"location\": \"Nairobi, Kenya\"\n}"}
          },
          "response": [{"name": "Success", "status": "Created", "code": 201, "header": [{"key": "Content-Type", "value": "application/json"}], "body": "{\n  \"id\": 1,\n  \"name\": \"Green Valley Farm\",\n  \"location\": \"Nairobi, Kenya\",\n  \"owner_id\": 1\n}"}]
        },
        {
          "name": "List My Farms",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{jwt_token}}"}],
            "url": {"raw": "{{base_url}}/api/v1/farms", "host": ["{{base_url}}"], "path": ["api","v1","farms"]}
          },
          "response": [{"name": "Success", "status": "OK", "code": 200, "header": [{"key": "Content-Type", "value": "application/json"}], "body": "[\n  {\n    \"id\": 1,\n    \"name\": \"Green Valley Farm\",\n    \"location\": \"Nairobi, Kenya\",\n    \"owner_id\": 1\n  }\n]"}]
        },
        {
          "name": "Get Farm by ID",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{jwt_token}}"}],
            "url": {"raw": "{{base_url}}/api/v1/farms/1", "host": ["{{base_url}}"], "path": ["api","v1","farms","1"]}
          },
          "response": [{"name": "Success", "status": "OK", "code": 200, "header": [{"key": "Content-Type", "value": "application/json"}], "body": "{\n  \"id\": 1,\n  \"name\": \"Green Valley Farm\",\n  \"location\": \"Nairobi, Kenya\",\n  \"owner_id\": 1\n}"},
            {"name": "Not Found", "status": "Not Found", "code": 404, "header": [{"key": "Content-Type", "value": "application/json"}], "body": "{\n  \"detail\": \"Farm not found\"\n}"}]
        },
        {
          "name": "Update Farm",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{jwt_token}}"}
            ],
            "url": {"raw": "{{base_url}}/api/v1/farms/1", "host": ["{{base_url}}"], "path": ["api","v1","farms","1"]},
            "body": {"mode": "raw", "raw": "{\n  \"name\": \"Green Valley Farm Updated\",\n  \"location\": \"Kisumu, Kenya\"\n}"}
          },
          "response": [{"name": "Success", "status": "OK", "code": 200, "header": [{"key": "Content-Type", "value": "application/json"}], "body": "{\n  \"id\": 1,\n  \"name\": \"Green Valley Farm Updated\",\n  \"location\": \"Kisumu, Kenya\",\n  \"owner_id\": 1\n}"}]
        },
        {
          "name": "Delete Farm",
          "request": {
            "method": "DELETE",
            "header": [{"key": "Authorization", "value": "Bearer {{jwt_token}}"}],
            "url": {"raw": "{{base_url}}/api/v1/farms/1", "host": ["{{base_url}}"], "path": ["api","v1","farms","1"]}
          },
          "response": [{"name": "Success", "status": "No Content", "code": 204}]
        }
      ]
    },
