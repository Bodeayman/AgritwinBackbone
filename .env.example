PROJECT_NAME=AgriTwin Backend
API_V1_STR=/api/v1

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/agritwin

# MinIO / S3 Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=REDACTED_MINIO_SECRET
MINIO_SECURE=False
MINIO_BUCKET_NAME=agritwin-bucket

# RabbitMQ
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

# CORS origins (comma-separated list or JSON array)
BACKEND_CORS_ORIGINS=*
