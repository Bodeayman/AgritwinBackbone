PROJECT_NAME=AgriTwin Backend
API_V1_STR=/api/v1

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=agritwin
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:your_secure_password_here@localhost:5432/agritwin

# JWT Authentication
JWT_SECRET_KEY=change_this_to_a_secure_random_string_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Internal Module API Keys (change these in production)
INTERN_2_API_KEY=change_intern_2_api_key
INTERN_3_API_KEY=change_intern_3_api_key
INTERN_4A_API_KEY=change_intern_4a_api_key
INTERN_4B_API_KEY=change_intern_4b_api_key
INTERN_5_API_KEY=change_intern_5_api_key
INTERN_7_API_KEY=change_intern_7_api_key
INTERN_8_API_KEY=change_intern_8_api_key

# MinIO / S3 Storage
MINIO_ENDPOINT=localhost:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_minio_password_here
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_minio_password_here
MINIO_SECURE=False
MINIO_BUCKET_NAME=agritwin-bucket

# RabbitMQ
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=change_rabbitmq_password_here
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# API Server
API_PORT=8000

# CORS origins (comma-separated list or JSON array)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000
