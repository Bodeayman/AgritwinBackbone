# =============================================================================
# AgriTwin Backend - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
#
# For EC2 deployment, place the .env file at:
#   /opt/agritwin-backend/.env
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
PROJECT_NAME=AgriTwin Backend
API_V1_STR=/api/v1

# -----------------------------------------------------------------------------
# Database (PostgreSQL with PostGIS)
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=agritwin
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}
# Note: Inside Docker Compose, the host is 'db', not 'localhost'.
# The web service builds this automatically:
#   DATABASE_URL=postgresql://<user>:<pass>@db:5432/<db>

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_SECURE_RANDOM_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# -----------------------------------------------------------------------------
# Internal Module API Keys
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# -----------------------------------------------------------------------------
INTERN_2_API_KEY=CHANGE_ME_intern_2_key
INTERN_3_API_KEY=CHANGE_ME_intern_3_key
INTERN_4A_API_KEY=CHANGE_ME_intern_4a_key
INTERN_4B_API_KEY=CHANGE_ME_intern_4b_key
INTERN_5_API_KEY=CHANGE_ME_intern_5_key
INTERN_7_API_KEY=CHANGE_ME_intern_7_key
INTERN_8_API_KEY=CHANGE_ME_intern_8_key

# -----------------------------------------------------------------------------
# MinIO / S3 Object Storage
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
MINIO_ENDPOINT=localhost:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CHANGE_ME_MINIO_PASSWORD
MINIO_SECURE=False
MINIO_BUCKET_NAME=agritwin-bucket

# -----------------------------------------------------------------------------
# RabbitMQ
# -----------------------------------------------------------------------------
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=CHANGE_ME_RABBITMQ_PASSWORD
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
# Note: Inside Docker Compose, RABBITMQ_URL is constructed automatically
#   RABBITMQ_URL=amqp://<user>:<pass>@rabbitmq:5672

# -----------------------------------------------------------------------------
# API Server
# -----------------------------------------------------------------------------
API_PORT=8000

# -----------------------------------------------------------------------------
# CORS Origins (comma-separated list)
# For production, use your actual domain(s):
#   BACKEND_CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
# -----------------------------------------------------------------------------
BACKEND_CORS_ORIGINS=*

# -----------------------------------------------------------------------------
# Docker (used by GitHub Actions and deploy scripts)
# -----------------------------------------------------------------------------
DOCKER_IMAGE=agritwin-web:latest
