{
  "info": {
    "name": "AgriTwin Farm Twin Core API",
    "_postman_id": "b8f2c3d4-e5f6-7a8b-9c0d-e9876543210f",
    "description": "Complete Postman collection for AgriTwin Backend.\n\n**Auth flow**: Run '01 - Auth' requests in order. The Login request auto-saves the JWT to the `jwt_token` collection variable.\n\n**Farmer routes**: Use Bearer {{jwt_token}} — automatically set after Login.\n\n**Internal routes**: Use X-API-Key {{api_key}}.\n\nAll requests include Postman test scripts for status codes, response structure, and variable extraction.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url",  "value": "http://localhost:8000", "type": "string" },
    { "key": "jwt_token", "value": "", "type": "string" },
    { "key": "api_key",   "value": "REDACTED_INTERN_KEY", "type": "string" },
    { "key": "farm_id",   "value": "1", "type": "string" },
    { "key": "field_id",  "value": "1", "type": "string" },
    { "key": "model_id",  "value": "1", "type": "string" }
  ],
  "item": [

    {
      "name": "01 - Auth (Farmer)",
      "item": [
        {
          "name": "Register Farmer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"farmer@example.com\",\n  \"password\": \"strongpassword123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 or 201', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "pm.test('Response has id and email', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('id');",
                  "    pm.expect(json).to.have.property('email');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Login Farmer (Get JWT)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"farmer@example.com\",\n  \"password\": \"strongpassword123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response contains access_token', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('access_token');",
                  "    pm.expect(json.access_token).to.be.a('string').and.not.empty;",
                  "});",
                  "// Auto-save JWT to collection variable",
                  "var json = pm.response.json();",
                  "if (json && json.access_token) {",
                  "    pm.collectionVariables.set('jwt_token', json.access_token);",
                  "    console.log('JWT saved to jwt_token variable.');",
                  "}"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },

    {
      "name": "02 - Farms (Farmer JWT)",
      "item": [
        {
          "name": "Create Farm (JWT)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/farms",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "farms"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Green Valley Farm\",\n  \"location\": \"Nairobi County, Kenya\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Response has id, name, owner_id', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('id');",
                  "    pm.expect(json).to.have.property('name');",
                  "    pm.expect(json).to.have.property('owner_id');",
                  "});",
                  "// Auto-save farm_id for downstream requests",
                  "var json = pm.response.json();",
                  "if (json && json.id) {",
                  "    pm.collectionVariables.set('farm_id', json.id.toString());",
                  "    console.log('farm_id saved:', json.id);",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "List My Farms (JWT)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "url": {
              "raw": "{{base_url}}/api/v1/farms?skip=0&limit=20",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "farms"],
              "query": [
                { "key": "skip",  "value": "0" },
                { "key": "limit", "value": "20" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response is array', function () {",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Get Farm by ID (JWT)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "url": {
              "raw": "{{base_url}}/api/v1/farms/{{farm_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "farms", "{{farm_id}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response has id matching farm_id', function () {",
                  "    var json = pm.response.json();",
                  "    var expectedId = parseInt(pm.collectionVariables.get('farm_id'));",
                  "    pm.expect(json.id).to.equal(expectedId);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },

