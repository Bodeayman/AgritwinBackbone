        {
          "name": "Set Field GPS Boundary (JWT)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/fields/{{field_id}}/boundary",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "fields", "{{field_id}}", "boundary"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"coordinates\": [\n    [\n      [36.821, -1.292],\n      [36.822, -1.292],\n      [36.822, -1.293],\n      [36.821, -1.293],\n      [36.821, -1.292]\n    ]\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Boundary has coordinates and area_hectares', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('coordinates');",
                  "    pm.expect(json.coordinates).to.be.an('array').with.length.above(0);",
                  "    pm.expect(json).to.have.property('area_hectares');",
                  "    pm.expect(json.area_hectares).to.be.above(0);",
                  "});",
                  "pm.test('Coordinates are valid GeoJSON rings', function () {",
                  "    var json = pm.response.json();",
                  "    var ring = json.coordinates[0];",
                  "    pm.expect(ring).to.be.an('array');",
                  "    // First and last point must close the ring",
                  "    var first = ring[0];",
                  "    var last  = ring[ring.length - 1];",
                  "    pm.expect(first[0]).to.equal(last[0]);",
                  "    pm.expect(first[1]).to.equal(last[1]);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
